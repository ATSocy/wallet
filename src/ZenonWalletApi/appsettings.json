{
	"Serilog": {
		"Using": [
			"Serilog.Sinks.Console"
		],
		"MinimumLevel": "Information",
		"WriteTo": [
			{
				"Name": "Console"
			}
		],
		"Enrich": [
			"FromLogContext",
			"WithMachineName",
			"WithProcessId",
			"WithThreadId"
		],
		"Properties": {
			"Application": "Zenon Wallet API"
		}
	},
	"Api": {
		"Jwt": {
			"Secret": "redacted",
			"ValidIssuer": "wallet.atsocy.com",
			"ValidAudience": "zenon.network",
			"ExpiresOn": null,
			"ExpiresAfter": null
		},
		"Node": {
			"NodeUrl": "ws://127.0.0.1:35998",
			"ChainId": 1,
			"ProtocolVersion": 1,
			"MaxPoWThreads": 5,
			"PlasmaMode": "PoW",
			"MinQsrThreshold": 100,
			"FuseTimeout": "00:01:30"
		},
		"Wallet": {
			"Path": "~/.znn/wallet",
			"Name": "api",
			"EraseLimit": 3
		},
		"Users": [
			{
				"Id": "redacted",
				"Username": "admin",
				"PasswordHash": "redacted",
				"Roles": [
					"Admin",
					"User"
				]
			},
			{
				"Id": "redacted",
				"Username": "user",
				"PasswordHash": "redacted",
				"Roles": [
					"User"
				]
			}
		]
	}
}
